// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id          String   @id @default(cuid())
  address     String   @unique
  chain       String
  firstSeen   DateTime @default(now())
  lastUpdated DateTime @updatedAt
  label       String?
  isVerified  Boolean  @default(false)
  isScam      Boolean  @default(false)
  metadata    Json     @default("{}")
  
  // ✅ Add this relation to match WalletMetric
  metrics     WalletMetric[]
  transactions WalletTransaction[]
  scans       ScannedWallet[]
}

model WalletMetric {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain       String
  timestamp   DateTime @default(now())
  
  totalPnl    Float    @default(0)
  totalRoi    Float    @default(0)
  winRate     Float    @default(0)
  tradeCount  Int      @default(0)
  winCount    Int      @default(0)
  lossCount   Int      @default(0)
  
  averageTrade Float   @default(0)
  bestTrade   Float    @default(0)
  worstTrade  Float    @default(0)
  totalVolume Float    @default(0)
  averageVolume Float  @default(0)
  
  maxDrawdown Float    @default(0)
  currentDrawdown Float @default(0)
  sharpeRatio Float    @default(0)
  volatility  Float    @default(0)
  
  walletScore Int      @default(0)
  riskScore   Int      @default(0)
  consistencyScore Int @default(0)
  
  portfolioValue Float @default(0)
  tokensCount Int      @default(0)
  nftsCount   Int      @default(0)
  
  activeDays  Int      @default(0)
  lastTrade   DateTime?
  firstTrade  DateTime?
  
  preferredTokens String[] @default([])
  preferredProtocols String[] @default([])
  
  performance24h Float @default(0)
  performance7d  Float @default(0)
  performance30d Float @default(0)
  performance90d Float @default(0)
  
  metadata    Json     @default("{}")
  
  @@unique([walletId, chain, timestamp])
  @@index([walletId, chain, timestamp(sort: Desc)])
  @@index([walletScore(sort: Desc)])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain       String
  hash        String   @unique
  fromAddress String?
  toAddress   String?
  tokenAddress String?
  tokenSymbol String?
  amount      Float    @default(0)
  valueUsd    Float    @default(0)
  priceUsd    Float    @default(0)
  timestamp   DateTime @default(now())
  blockNumber BigInt?
  transactionType String?
  status      String?
  gasUsed     Float?
  gasPrice    Float?
  
  @@index([walletId, timestamp(sort: Desc)])
  @@index([tokenAddress, timestamp(sort: Desc)])
}

model ScannerFilter {
  id          String   @id @default(cuid())
  name        String
  filter      Json
  userId      String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  @@unique([name, userId])
}

model ScannedWallet {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  scanId      String?
  score       Int      @default(0)
  rank        Int      @default(0)
  timestamp   DateTime @default(now())
  matchedFilters Json   @default("{}")
  
  @@index([walletId, timestamp(sort: Desc)])
}